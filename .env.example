# Copy this file to .env and fill in the values. Never commit .env.

# Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# True only on your own machine.
DEBUG=True

# Comma-separated host names the site is served on (not needed while DEBUG=True locally).
ALLOWED_HOSTS=

DB_NAME=careerpathdb
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
